+        .filter((result) => result.status === TestStatus.Failed)
+        .map((result) => result.fileName));
+    return files
+        .filter((file) => file.result?.state === 'fail')
+        .filter((file) => !failedFileNames.has(path.resolve(file.filepath)))
+        .map((file) => {
+        const name = 'StrykerJS: test file failed to load or collect';
+        return {
+            id: normalizeTestId(`${file.filepath}#${name}`),
